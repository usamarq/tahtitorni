---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sky from '../../components/Sky.astro';
import Sigil from '../../components/Sigil.astro';
import { workGroups } from '../../data/work';
import { toys } from '../../data/cv';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((e) => e.id === entry.id);
const prev = i > 0 ? all[i - 1] : null;
const next = i < all.length - 1 ? all[i + 1] : null;
const groupLabel = workGroups.find((g) => g.id === entry.data.group)?.label;
const plate = `plate ${String(entry.data.order).padStart(2, '0')} / ${all.length}`;
const toy = entry.data.toy ? toys.find((t) => t.id === entry.data.toy) : undefined;
---

<Base title={`${entry.data.title} · Usama Raheel`} description={entry.data.blurb}>
  <div class="head-zone">
    <Sky density={12} fade="bottom" />
    <div class="big-sigil" aria-hidden="true">
      <Sigil seed={entry.id} size={330} />
    </div>
    <header class="wrap detail-head">
      <p class="crumb">
        <a href="/work/">Work</a> <i>✦</i> <span>{groupLabel}</span>
        <span class="plate">{plate}</span>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="meta">{entry.data.kind} · {entry.data.org} · {entry.data.dates}</p>
      {entry.data.metrics && <p class="metrics">{entry.data.metrics}</p>}
      {entry.data.links.length > 0 && (
        <div class="links">
          {entry.data.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
          ))}
        </div>
      )}
    </header>
  </div>

  <article class="wrap detail">
    <span class="plate-margin" aria-hidden="true">{plate} · {groupLabel}</span>
    <div class="prose">
      <Content />
    </div>

    {toy && (
      <aside class="toy-note">
        <span class="lab">From the playground</span>
        <p>
          <a href={toy.href}><i>✦</i> {toy.title}</a> · {toy.desc.replace(/\.$/, '')} · it runs
          right there on the page.
        </p>
      </aside>
    )}

    <nav class="pager" aria-label="More work">
      {prev ? <a href={`/work/${prev.id}/`} rel="prev">← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/work/${next.id}/`} rel="next">{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .head-zone { position: relative; overflow: hidden; }
  .big-sigil {
    position: absolute;
    right: 5%;
    top: 34px;
    z-index: 0;
    color: var(--brass);
    opacity: 0.13;
    pointer-events: none;
  }
  .detail-head {
    position: relative;
    z-index: 1;
    max-width: 820px;
    padding-top: 56px;
    padding-bottom: 34px;
  }
  .detail { max-width: 820px; }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    font-family: var(--ff-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .crumb a { color: var(--muted); }
  .crumb a:hover { color: var(--brass); }
  .crumb i {
    color: var(--brass);
    font-style: normal;
    text-shadow: 0 0 9px hsl(var(--accent-h) 60% 60% / 0.5);
  }
  .crumb .plate { margin-left: auto; color: var(--faint); letter-spacing: 0.14em; }
  h1 {
    font-family: var(--ff-serif);
    font-size: clamp(34px, 5.4vw, 52px);
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1.12;
    margin: 18px 0 14px;
  }
  .meta { font-family: var(--ff-mono); font-size: 12.5px; color: var(--faint); }
  .metrics {
    margin-top: 14px;
    font-family: var(--ff-mono);
    font-size: 13px;
    color: var(--brass);
    font-variant-numeric: tabular-nums;
  }
  .links { margin-top: 14px; display: flex; gap: 20px; flex-wrap: wrap; font-size: 13.5px; }
  .links a { color: var(--muted); border-bottom: 1px solid var(--hairline); padding-bottom: 1px; }
  .links a:hover { color: var(--brass); border-color: var(--brass-line); }

  .prose { margin-top: 10px; max-width: 66ch; }
  .prose :global(p) { margin-bottom: 18px; font-size: 16px; line-height: 1.8; font-variant-numeric: oldstyle-nums; }
  .prose :global(em) { font-family: var(--ff-serif); font-style: italic; font-size: 1.04em; }
  .prose :global(h2) {
    font-family: var(--ff-serif);
    font-size: 24px;
    font-weight: 500;
    margin: 38px 0 12px;
  }
  .prose :global(h2)::before {
    content: '✦ ';
    color: var(--brass);
    font-size: 14px;
    vertical-align: 3px;
    text-shadow: 0 0 9px hsl(var(--accent-h) 60% 60% / 0.5);
  }
  .prose :global(ul) { list-style: disc outside; margin: 0 0 18px 20px; color: var(--muted); }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(a) { border-bottom: 1px solid var(--hairline); }
  .prose :global(a:hover) { color: var(--brass); border-color: var(--brass-line); }

  /* drop cap on the opening paragraph, skipped when it begins with a citation */
  .prose > :global(p:first-child:not(:has(> em:first-child)))::first-letter {
    font-family: var(--ff-serif);
    font-style: italic;
    font-size: 3.05em;
    line-height: 0.85;
    float: left;
    color: var(--brass);
    margin: 5px 10px 0 0;
  }

  .toy-note {
    margin-top: 52px;
    padding-top: 18px;
    border-top: 1px solid var(--hairline);
    max-width: 66ch;
  }
  .toy-note .lab {
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .toy-note p { margin-top: 8px; color: var(--muted); font-size: 14.5px; }
  .toy-note a { color: var(--ink); border-bottom: 1px solid var(--hairline); padding-bottom: 1px; }
  .toy-note a:hover { color: var(--brass); border-color: var(--brass-line); }
  .toy-note i {
    color: var(--brass);
    font-style: normal;
    font-size: 12px;
    text-shadow: 0 0 9px hsl(var(--accent-h) 60% 60% / 0.5);
  }

  .pager {
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 14px;
  }
  .pager a { color: var(--muted); max-width: 44%; }
  .pager a[rel='next'] { text-align: right; margin-left: auto; }
  .pager a:hover { color: var(--brass); }

  @media (max-width: 900px) {
    .big-sigil { display: none; }
  }
  @media (max-width: 760px) {
    .detail-head { padding-top: 36px; }
  }

  /* plate label running down the left margin, atlas style */
  .plate-margin { display: none; }
  @media (min-width: 1440px) {
    .detail { position: relative; }
    .plate-margin {
      display: block;
      position: absolute;
      left: -66px;
      top: 16px;
      writing-mode: vertical-rl;
      font-family: var(--ff-mono);
      font-size: 11px;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: var(--faint);
      opacity: 0.7;
      pointer-events: none;
    }
  }

  @media (min-width: 1600px) {
    .prose :global(p) { font-size: 17px; }
    .prose :global(ul) { font-size: 16px; }
  }
</style>
