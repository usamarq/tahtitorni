---
/* Constellation canvas. Parent must be position: relative; this fills it.
   Multiple instances per page share one module script and one draw loop.
   Lines and bright stars get a soft glow: a wide low-alpha pass under a
   thin bright one, which is far cheaper than canvas shadowBlur. */
interface Props {
  density?: number; // px of width per star; lower = denser
  interactive?: boolean; // constellations follow the cursor
  polaris?: boolean; // label the pole star (hero only)
  fade?: 'bottom' | 'top' | 'both' | 'none';
}
const { density = 7, interactive = true, polaris = false, fade = 'bottom' } = Astro.props;
---

<canvas
  class="sky"
  aria-hidden="true"
  data-density={String(density)}
  data-interactive={interactive ? '1' : '0'}
  data-polaris={polaris ? '1' : '0'}
  data-fade={fade}></canvas>

<style>
  .sky { position: absolute; inset: 0; z-index: 0; }
  .sky[data-fade='bottom'] {
    -webkit-mask-image: linear-gradient(to bottom, black 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 62%, transparent 100%);
  }
  .sky[data-fade='top'] {
    -webkit-mask-image: linear-gradient(to top, black 45%, transparent 100%);
    mask-image: linear-gradient(to top, black 45%, transparent 100%);
  }
  .sky[data-fade='both'] {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 70%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 70%, transparent 100%);
  }
  @media print {
    .sky { display: none; }
  }
</style>

<script>
  type Star = {
    x: number; y: number; r: number; base: number; amp: number;
    phase: number; speed: number; gold: boolean; name?: string;
  };
  type Inst = {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    host: HTMLElement;
    density: number;
    interactive: boolean;
    polaris: boolean;
    stars: Star[];
    mouse: { x: number; y: number };
    /* true while a real mouse is over the host; otherwise a slow virtual
       cursor roams the band so constellations form on their own (the only
       way touch screens ever see them) */
    pointerActive: boolean;
    p1: number;
    p2: number;
    W: number;
    H: number;
    onscreen: boolean;
  };

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);

  // palette is read from tokens so the sky follows theme and accent knob
  let starRGB = '210, 222, 244';
  let lineRGB = '143, 168, 216';
  let brassHSL = '42 52% 56%';
  let labelColor = 'rgba(95, 104, 128, 0.85)';
  function readPalette() {
    const cs = getComputedStyle(document.documentElement);
    starRGB = cs.getPropertyValue('--sky-star').trim() || starRGB;
    lineRGB = cs.getPropertyValue('--sky-line').trim() || lineRGB;
    const h = cs.getPropertyValue('--accent-h').trim() || '42';
    const s = cs.getPropertyValue('--brass-s').trim() || '52%';
    const l = cs.getPropertyValue('--brass-l').trim() || '56%';
    brassHSL = `${h} ${s} ${l}`;
    const faint = cs.getPropertyValue('--faint').trim();
    if (faint) labelColor = faint;
  }
  const brass = (a: number) => `hsl(${brassHSL} / ${a})`;

  const insts: Inst[] = [];
  let running = false;

  function resize(inst: Inst) {
    inst.W = inst.host.clientWidth;
    inst.H = inst.host.clientHeight;
    inst.canvas.width = inst.W * dpr;
    inst.canvas.height = inst.H * dpr;
    inst.canvas.style.width = inst.W + 'px';
    inst.canvas.style.height = inst.H + 'px';
    inst.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function seed(inst: Inst) {
    inst.stars = [];
    const n = Math.min(150, Math.floor(inst.W / inst.density));
    for (let i = 0; i < n; i++) {
      inst.stars.push({
        x: Math.random() * inst.W,
        y: Math.random() * inst.H,
        r: Math.random() < 0.12 ? 1.6 : 0.9,
        base: 0.25 + Math.random() * 0.45,
        amp: 0.12 + Math.random() * 0.22,
        phase: Math.random() * Math.PI * 2,
        speed: 0.0006 + Math.random() * 0.0009,
        gold: Math.random() < 0.14,
      });
    }
    if (inst.polaris && inst.stars.length) {
      /* higher up on narrow screens so the label clears the hero text */
      inst.stars[0] = {
        x: inst.W * 0.82, y: inst.H * (inst.W < 560 ? 0.08 : 0.18), r: 2.1, base: 0.85, amp: 0.1,
        phase: 0, speed: 0.0007, gold: true, name: 'polaris',
      };
    }
  }

  function glowLine(
    ctx: CanvasRenderingContext2D,
    x1: number, y1: number, x2: number, y2: number,
    core: string, halo: string, w: number
  ) {
    ctx.strokeStyle = halo;
    ctx.lineWidth = w * 4.5;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.strokeStyle = core;
    ctx.lineWidth = w;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
  }

  function draw(inst: Inst, t: number) {
    const { ctx, W, H, stars, mouse } = inst;
    if (!reduced && !inst.pointerActive) {
      /* the roaming cursor: a slow Lissajous drift, one wander ~2 minutes */
      const rt = t * 0.00005;
      mouse.x = W * (0.5 + 0.42 * Math.sin(rt * 1.1 + inst.p1) * Math.cos(rt * 0.53 + inst.p2));
      mouse.y = H * (0.5 + 0.4 * Math.sin(rt * 0.79 + inst.p2));
    }
    ctx.clearRect(0, 0, W, H);

    // faint fixed constellation lines, breathing a little light
    for (let i = 0; i < stars.length; i += 7) {
      const a = stars[i];
      const b = stars[(i + 3) % stars.length];
      if (!a || !b) continue;
      const dx = a.x - b.x;
      const dy = a.y - b.y;
      if (dx * dx + dy * dy < 36000) {
        glowLine(ctx, a.x, a.y, b.x, b.y, `rgba(${lineRGB}, 0.1)`, `rgba(${lineRGB}, 0.03)`, 0.6);
      }
    }

    // constellations near the cursor (real or roaming), in glowing brass
    {
      const near = stars.filter((s) => {
        const dx = s.x - mouse.x;
        const dy = s.y - mouse.y;
        return dx * dx + dy * dy < 13000;
      });
      for (let i = 0; i < near.length; i++) {
        for (let j = i + 1; j < near.length; j++) {
          const dx = near[i].x - near[j].x;
          const dy = near[i].y - near[j].y;
          if (dx * dx + dy * dy < 6400) {
            glowLine(ctx, near[i].x, near[i].y, near[j].x, near[j].y, brass(0.5), brass(0.12), 0.9);
          }
        }
      }
    }

    // stars, with halos on the bright ones
    for (const s of stars) {
      const alpha = reduced
        ? s.base
        : Math.max(0.08, s.base + Math.sin(t * s.speed + s.phase) * s.amp);
      if (s.gold) {
        ctx.fillStyle = brass(alpha * 0.16);
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r * 4.5, 0, Math.PI * 2);
        ctx.fill();
      } else if (s.r > 1.2) {
        ctx.fillStyle = `rgba(${starRGB}, ${alpha * 0.14})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r * 3.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = s.gold ? brass(alpha) : `rgba(${starRGB}, ${alpha})`;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
      if (s.name) {
        ctx.fillStyle = labelColor;
        ctx.font = '10px Consolas, monospace';
        const label = `${s.name} · 65°N`;
        if (s.x + 10 + ctx.measureText(label).width > W - 8) {
          ctx.textAlign = 'right';
          ctx.fillText(label, s.x - 10, s.y + 3);
          ctx.textAlign = 'left';
        } else {
          ctx.fillText(label, s.x + 10, s.y + 3);
        }
      }
    }
  }

  function drawAll() {
    for (const inst of insts) if (inst.onscreen) draw(inst, 0);
  }
  function anyVisible() {
    return !document.hidden && insts.some((i) => i.onscreen);
  }
  function loop(t: number) {
    if (!anyVisible()) {
      running = false;
      return;
    }
    for (const inst of insts) if (inst.onscreen) draw(inst, t);
    requestAnimationFrame(loop);
  }
  function ensure() {
    if (reduced) {
      drawAll();
      return;
    }
    if (!running && anyVisible()) {
      running = true;
      requestAnimationFrame(loop);
    }
  }

  const io = new IntersectionObserver((entries) => {
    for (const en of entries) {
      const inst = insts.find((i) => i.canvas === en.target);
      if (inst) inst.onscreen = en.isIntersecting;
    }
    ensure();
  });

  readPalette();
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas.sky')) {
    const host = canvas.parentElement;
    const ctx = canvas.getContext('2d');
    if (!host || !ctx) continue;
    const inst: Inst = {
      canvas, ctx, host,
      density: Number(canvas.dataset.density || '7'),
      interactive: canvas.dataset.interactive === '1',
      polaris: canvas.dataset.polaris === '1',
      stars: [], mouse: { x: -9999, y: -9999 },
      pointerActive: false,
      p1: Math.random() * Math.PI * 2,
      p2: Math.random() * Math.PI * 2,
      W: 0, H: 0, onscreen: true,
    };
    insts.push(inst);
    resize(inst);
    seed(inst);
    if (inst.interactive) {
      /* mouse only: a touch scroll must not freeze the roaming cursor */
      host.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = host.getBoundingClientRect();
        inst.mouse.x = e.clientX - r.left;
        inst.mouse.y = e.clientY - r.top;
        inst.pointerActive = true;
        if (reduced) draw(inst, 0);
      });
      host.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse') return;
        inst.mouse.x = -9999;
        inst.mouse.y = -9999;
        inst.pointerActive = false;
        if (reduced) draw(inst, 0);
      });
    }
    io.observe(canvas);
  }

  window.addEventListener('resize', () => {
    for (const inst of insts) {
      resize(inst);
      seed(inst);
    }
    if (reduced) drawAll();
  });
  window.addEventListener('themechange', () => {
    readPalette();
    if (reduced) drawAll();
  });
  document.addEventListener('visibilitychange', ensure);

  if (reduced) drawAll();
  else ensure();
</script>
