---
/* A small deterministic constellation, seeded from a string (the entry slug):
   every project gets its own star sign. Server-rendered SVG, zero JS.
   Color comes from currentColor. */
interface Props {
  seed: string;
  size?: number;
}
const { seed, size = 32 } = Astro.props;

function hash32(str: string) {
  let h = 2166136261;
  for (const c of str) {
    h ^= c.charCodeAt(0);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}
function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rnd = mulberry32(hash32(seed));
const n = 5 + Math.floor(rnd() * 3);

const pts: { x: number; y: number }[] = [];
let guard = 0;
while (pts.length < n && guard++ < 200) {
  const x = 14 + rnd() * 72;
  const y = 14 + rnd() * 72;
  if (pts.every((p) => Math.hypot(p.x - x, p.y - y) > 24)) pts.push({ x, y });
}

/* connect as a nearest-neighbor chain for a plausible constellation shape */
const chain = [pts[0]];
const rest = pts.slice(1);
while (rest.length) {
  const last = chain[chain.length - 1];
  let bi = 0;
  let bd = Infinity;
  rest.forEach((p, i) => {
    const d = Math.hypot(p.x - last.x, p.y - last.y);
    if (d < bd) {
      bd = d;
      bi = i;
    }
  });
  chain.push(rest.splice(bi, 1)[0]);
}
const path = chain.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
const bright = Math.floor(rnd() * chain.length);
---

<svg class="sigil" viewBox="0 0 100 100" width={size} height={size} aria-hidden="true">
  <path d={path} fill="none" stroke="currentColor" stroke-width="4" opacity="0.1" stroke-linejoin="round" />
  <path d={path} fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.55" stroke-linejoin="round" />
  {chain.map((p, i) => (
    <circle cx={p.x} cy={p.y} r={i === bright ? 7 : 4} fill="currentColor" opacity="0.14" />
  ))}
  {chain.map((p, i) => (
    <circle cx={p.x} cy={p.y} r={i === bright ? 2.7 : 1.7} fill="currentColor" />
  ))}
</svg>
